import time

def build_plus(parts):
    result = ""

    for part in parts:
        result += part + ";"

    return result


def build_join(parts):
    return ";".join(parts) + ";"


items = [f"Record-{i}" for i in range(10000)]

start = time.perf_counter()
result1 = build_plus(items)
time1 = time.perf_counter() - start

start = time.perf_counter()
result2 = build_join(items)
time2 = time.perf_counter() - start

print("Outputs identical:", result1 == result2)
print("Plus time:", time1)
print("Join time:", time2)